{
  "name": "spellbound-arena",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Portrait-first pixel-art rune-drawing survival shooter (Poki).",
  "scripts": {
    "art": "node tools/art/build.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "release": "npm run build && node tools/release/zip.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
